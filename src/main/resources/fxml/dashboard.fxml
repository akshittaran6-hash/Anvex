<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="root" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.anvex.ui.DashboardController">
    <top>
        <VBox styleClass="header-pane">
            <padding><Insets top="12" right="22" bottom="12" left="22"/></padding>
            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="1">
                    <Label text="ANVEX" styleClass="title-label"/>
                    <Label text="LOCAL CYBERSECURITY LABORATORY" styleClass="subtitle-label"/>
                </VBox>
                <Separator orientation="VERTICAL" styleClass="header-separator"/>
                <Label fx:id="serverStatusLabel" text="SERVER: OFFLINE" styleClass="status-label offline"/>
                <Label fx:id="defenseStatusLabel" text="DEFENSE: OFF" styleClass="status-label offline"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="scenarioLabel" text="SCENARIO 1" styleClass="info-label"/>
                <Label fx:id="runLabel" text="RUN: —" styleClass="info-label run-info"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="dashboard-scroll">
            <VBox spacing="12" styleClass="main-content">
                <padding><Insets top="14" right="20" bottom="16" left="20"/></padding>

                <HBox spacing="12" styleClass="intro-row">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Security experiment" styleClass="page-title"/>
                        <Label text="Run the same controlled attack twice and compare the measured outcome." styleClass="page-description"/>
                    </VBox>
                    <VBox spacing="2" alignment="CENTER_RIGHT" styleClass="run-note">
                        <Label text="LOCAL ONLY" styleClass="run-note-title"/>
                        <Label text="127.0.0.1 : 9090" styleClass="run-note-value"/>
                    </VBox>
                </HBox>

                <VBox spacing="9" styleClass="panel topology-pane">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="ATTACK PATH" styleClass="section-title"/>
                        <Label text="SCENARIO 1" styleClass="section-badge"/>
                    </HBox>
                    <HBox fx:id="topologyContent" spacing="10" alignment="CENTER" styleClass="topology-content">
                        <VBox styleClass="node attacker-node" spacing="4" alignment="CENTER">
                            <Label text="ATTACKER" styleClass="node-title"/>
                            <Label text="2000 ordered requests" styleClass="node-meta"/>
                        </VBox>
                        <Label text="→" styleClass="topology-arrow"/>
                        <VBox styleClass="node server-node" spacing="4" alignment="CENTER">
                            <Label text="AUTHENTICATION SERVER" styleClass="node-title"/>
                            <Label text="127.0.0.1:9090" styleClass="node-meta"/>
                        </VBox>
                        <Label text="→" styleClass="topology-arrow"/>
                        <VBox styleClass="node database-node" spacing="4" alignment="CENTER">
                            <Label text="H2 DATABASE" styleClass="node-title"/>
                            <Label text="events and run metrics" styleClass="node-meta"/>
                        </VBox>
                        <VBox styleClass="defense-summary" spacing="3" alignment="CENTER">
                            <Label text="ACCOUNT LOCKOUT" styleClass="defense-title"/>
                            <Label text="5 failed logins" styleClass="node-meta"/>
                            <Label text="defense threshold" styleClass="node-meta"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox spacing="9" styleClass="panel">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="RUN RESULTS" styleClass="section-title"/>
                        <Label text="CURRENT RUN" styleClass="section-badge"/>
                    </HBox>
                    <HBox spacing="9" styleClass="metrics-row">
                        <VBox fx:id="totalAttemptsCard" styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <Label text="TOTAL ATTEMPTS" styleClass="metric-title"/>
                            <Label fx:id="totalAttemptsValue" text="0" styleClass="metric-value"/>
                        </VBox>
                        <VBox fx:id="failedCard" styleClass="metric-card warning" HBox.hgrow="ALWAYS">
                            <Label text="FAILED" styleClass="metric-title"/>
                            <Label fx:id="failedValue" text="0" styleClass="metric-value"/>
                        </VBox>
                        <VBox fx:id="blockedCard" styleClass="metric-card blocked" HBox.hgrow="ALWAYS">
                            <Label text="BLOCKED" styleClass="metric-title"/>
                            <Label fx:id="blockedValue" text="0" styleClass="metric-value"/>
                        </VBox>
                        <VBox fx:id="successCard" styleClass="metric-card danger" HBox.hgrow="ALWAYS">
                            <Label text="ATTACK SUCCESS" styleClass="metric-title"/>
                            <Label fx:id="successValue" text="0" styleClass="metric-value"/>
                        </VBox>
                        <VBox fx:id="alertsCard" styleClass="metric-card alert" HBox.hgrow="ALWAYS">
                            <Label text="ALERTS" styleClass="metric-title"/>
                            <Label fx:id="alertsValue" text="0" styleClass="metric-value"/>
                        </VBox>
                        <VBox fx:id="legitSuccessCard" styleClass="metric-card success" HBox.hgrow="ALWAYS">
                            <Label text="LEGIT SUCCESS" styleClass="metric-title"/>
                            <Label fx:id="legitSuccessValue" text="0" styleClass="metric-value"/>
                        </VBox>
                    </HBox>
                </VBox>

                <HBox spacing="12" styleClass="lower-row">
                    <VBox spacing="9" styleClass="panel control-pane" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="EXPERIMENT CONTROL" styleClass="section-title"/>
                            <Label text="STEP BY STEP" styleClass="section-badge"/>
                        </HBox>
                        <Label text="Start with the baseline, then enable the lockout defense and repeat the attack." styleClass="control-help" wrapText="true"/>
                        <HBox spacing="7" alignment="CENTER_LEFT">
                            <Button fx:id="startBaselineBtn" text="START BASELINE" styleClass="btn-primary" onAction="#handleStartBaseline"/>
                            <Button fx:id="runAttackBtn" text="RUN ATTACK" styleClass="btn-danger" onAction="#handleRunAttack" disable="true"/>
                            <Button fx:id="enableDefenseBtn" text="ENABLE DEFENSE" styleClass="btn-warning" onAction="#handleEnableDefense" disable="true"/>
                            <Button fx:id="runProtectedAttackBtn" text="RUN PROTECTED ATTACK" styleClass="btn-success" onAction="#handleRunProtectedAttack" disable="true"/>
                        </HBox>
                        <HBox spacing="7" alignment="CENTER_LEFT">
                            <Button fx:id="compareBtn" text="COMPARE RUNS" styleClass="btn-info" onAction="#handleCompare" disable="true"/>
                            <Button fx:id="replayBtn" text="VIEW REPLAY" styleClass="btn-info" onAction="#handleReplay" disable="true"/>
                            <Button fx:id="exportBtn" text="EXPORT REPORT" styleClass="btn-secondary" onAction="#handleExport" disable="true"/>
                            <Button fx:id="resetBtn" text="RESET" styleClass="btn-secondary" onAction="#handleReset"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="8" styleClass="panel summary-pane">
                        <Label text="WHAT THIS RUN SHOWS" styleClass="section-title"/>
                        <Label text="Baseline" styleClass="summary-label baseline"/>
                        <Label text="Attack succeeds when protection is off." styleClass="summary-text" wrapText="true"/>
                        <Label text="Protected" styleClass="summary-label protected"/>
                        <Label text="Repeated failures trigger account lockout and stop the attack." styleClass="summary-text" wrapText="true"/>
                    </VBox>
                </HBox>

                <VBox spacing="8" styleClass="panel events-pane">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="EVENT LOG" styleClass="section-title"/>
                        <Label text="LIVE" styleClass="section-badge"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Canonical security events" styleClass="events-caption"/>
                    </HBox>
                    <ScrollPane fx:id="eventsScrollPane" styleClass="events-scroll" fitToWidth="true" prefHeight="220">
                        <TextArea fx:id="eventsTextArea" editable="false" wrapText="true" styleClass="events-textarea"/>
                    </ScrollPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="footer-pane" alignment="CENTER_LEFT">
            <padding><Insets top="7" right="20" bottom="7" left="20"/></padding>
            <Label fx:id="footerLabel" text="ANVEX v1.0  •  Educational Cybersecurity Laboratory  •  Traffic restricted to 127.0.0.1" styleClass="footer-label"/>
        </HBox>
    </bottom>
</BorderPane>
